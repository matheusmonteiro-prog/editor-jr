node_modules
dist
.DS_Store
.env

# Ignore the output video from Git but not videos you import into src/.
out

# Vídeos nunca vão para o Git (brutos ou exportados)
videos/*
!videos/0926.cortes.json
# vídeos de trabalho dentro de public/ também ficam fora do Git
public/videos/
*.mp4
*.mov
*.mkv
*.webm

# Cópias de segurança dos vídeos brutos (ficam só no PC)
backup-videos/

# .claude/skills/* em geral são links simbólicos para .agents/skills/ (o
# conteúdo real, que fica versionado). Com core.symlinks=false o Git não
# salva link nenhum, duplica os arquivos. O link é recriado sozinho pela
# ferramenta quando a skill é usada — não precisa ir pro Git.
# Exceção: .claude/skills/editor-jr/ não é link nenhum, é a skill própria
# do projeto, escrita à mão — essa precisa ir pro Git.
.claude/skills/*
!.claude/skills/editor-jr/
# Skills próprias do fluxo de edição (04/11/2026), escritas à mão.
!.claude/skills/editar-video/
!.claude/skills/pedido-de-ajustes/
!.claude/skills/ajustar-kit-visual/
!.claude/skills/renderizar/
!.claude/skills/gerar-midia-ia/
!.claude/skills/tratar-audio/
!.claude/skills/cenas-3d/
!.claude/skills/recorte-fundo/

# Configuração local de permissões do Claude Code, específica da máquina.
.claude/settings.local.json

# Configuração local (caminhos do whisper.cpp e do modelo; cada PC tem o seu).
# O modelo para copiar é config.exemplo.json.
config.local.json

# Áudio fora do Git (licença de cada faixa; ver ARQUITETURA.md)
public/music/
public/sfx/

# Itens separados para apagar (só o Matheus manda apagar; ver _para-apagar/LEIA.md)
_para-apagar/

# Python local do teste de eco (WPE), 04/11/2026
.vc-audio/
.vc-enhance/

# Cópias de plano baixadas pelo editor local (editor/), 11/11/2026
planos/copias/
