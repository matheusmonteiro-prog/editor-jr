node_modules
dist
.DS_Store
.env

# Ignore the output video from Git but not videos you import into src/.
out

# Vídeos nunca vão para o Git (brutos ou exportados)
videos/
*.mp4
*.mov
*.mkv
*.webm

# .claude/skills/* são links simbólicos para .agents/skills/ (o conteúdo real,
# que fica versionado). Com core.symlinks=false o Git não salva link nenhum,
# duplica os arquivos. O link é recriado sozinho pela ferramenta quando a
# skill é usada — não precisa ir pro Git.
.claude/skills/
